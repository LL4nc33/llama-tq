#version 450

// ============================================================================
// dequant_ktq2_1.comp — Block-level dequant for GGML_TYPE_KTQ2_1.
//
// One workgroup per block, 32 invocations per workgroup (one lane per element
// in QK_KTQ=32). Mirrors CUDA `dequantize_block_ktq2_1_v2` in
// ggml/src/ggml-cuda/turboquant.cuh:352-382, including the warp-cooperative
// FWHT in `ktq_cuda_fwht_warp` (turboquant.cuh:255-263).
//
// Block layout (14 B, ggml-common.h:317-322):
//   offset 0  : ggml_half d              // fp16 norm (with v5 norm-correction)
//   offset 2  : uint8_t   qs[8]          // 2-bit codebook indices, 4/byte (LSB first)
//   offset 10 : uint8_t   sb[4]          // RHT sign bits, 1/element (LSB first)
//
// Sign convention mirrored from CUDA: `(1.0 - 2.0 * sb_bit)` — bit 0 → +1, bit 1 → -1.
// Codebook scaling applied BEFORE FWHT (matches CUDA: cb_val * PQ_CB_SCALE → fwht).
// FWHT itself returns val*PQ_CB_SCALE (1/sqrt(32)) at end, so the overall scale
// from codebook entry to post-FWHT lane value is (cb * 1/sqrt(32)) → fwht butterflies → (* 1/sqrt(32)).
// This is the exact CUDA arithmetic order.
// ============================================================================

#extension GL_KHR_shader_subgroup_basic   : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8  : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_16bit_storage    : require
#extension GL_EXT_scalar_block_layout     : require
#extension GL_EXT_control_flow_attributes : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

// 14-byte block. Use scalar block layout so this matches the C struct exactly
// (no std430 padding insertions) — VK_EXT_scalar_block_layout required.
struct block_ktq2_1 {
    float16_t d;
    uint8_t   qs[8];
    uint8_t   sb[4];
};

layout(scalar, binding = 0) readonly  buffer A { block_ktq2_1 data_a[]; };
layout(scalar, binding = 1) writeonly buffer D { float        data_d[]; };

// Inline const codebook (Variant B per Layer 2 Probe 3 recommendation; matches
// in-tree IQ-quant convention, gives glslc the strongest constant-fold hint).
const float PQ_CB_2BIT[4] = float[4](
    -1.489560,
    -0.451428,
     0.451428,
     1.489560
);

// 1/sqrt(32). Identical to CUDA `PQ_CUDA_CB_SCALE` (turboquant.cuh:130).
const float PQ_CB_SCALE = 0.17677669529663689;

void main() {
    const uint ib   = gl_WorkGroupID.x;
    const uint lane = gl_SubgroupInvocationID;   // == gl_LocalInvocationID.x in a 32-thread WG with subgroup_size=32

    // -----------------------------------------------------------------------
    // 1. fp16 norm. CUDA: `const float norm = (float)x[ib].d;`
    //    NOTE on early-return on norm==0: CUDA has it but only OUTSIDE the
    //    warp-cooperative dequant_block kernel. The FA-path (warp dequant)
    //    explicitly does NOT early-return because every lane must reach the
    //    shuffles. This shader is the row-dequant analogue but to keep it
    //    safe across drivers we follow the FA convention: no early-return.
    //    A norm of 0 simply produces all zeros via the multiply at the end.
    // -----------------------------------------------------------------------
    const float norm = float(data_a[ib].d);

    // -----------------------------------------------------------------------
    // 2. Codebook lookup. Matches turboquant.cuh:367-368:
    //      const int idx = (x[ib].qs[tid / 4] >> (2 * (tid % 4))) & 0x3;
    //      float val = PQ_CUDA_CB_2BIT[idx] * PQ_CUDA_CB_SCALE;
    //
    //    `lane >> 2` = lane/4, `(lane & 3) << 1` = 2*(lane%4). Mirrors CUDA
    //    bit-extract exactly (LSB-first packing, 4 elements/byte).
    // -----------------------------------------------------------------------
    const uint qbyte = uint(data_a[ib].qs[lane >> 2]);
    const uint idx   = (qbyte >> ((lane & 3u) << 1u)) & 0x3u;
    float val        = PQ_CB_2BIT[idx] * PQ_CB_SCALE;

    // -----------------------------------------------------------------------
    // 3. FWHT — 5 stages of warp-shuffle butterfly. Mirrors
    //    `ktq_cuda_fwht_warp` (turboquant.cuh:255-263) exactly:
    //
    //        for (int step = 1; step < 32; step <<= 1) {
    //            float other = __shfl_xor_sync(..., val, step);
    //            float sum   = val + other;
    //            float diff  = other - val;
    //            val = (threadIdx.x & step) ? diff : sum;
    //        }
    //        return val * 0.17677669529663689f;
    //
    //    DEFENSIVE `subgroupBarrier()` between stages: Layer 2 driver probe
    //    (commit `2d2f0b4be`) confirmed bit-exact correctness on RTX 2060 +
    //    580.126.09 *with and without* the barrier across 65536 workgroups.
    //    Kept as portability hedge for MoltenVK / older RADV / future regressions.
    //    Zero correctness risk; micro-cost on Turing.
    //
    //    CRITICAL: every lane must enter and exit the loop together. Do NOT
    //    early-return based on `norm` before this loop — it would leave some
    //    lanes outside the shuffle, which is undefined on NVIDIA Volta+.
    // -----------------------------------------------------------------------
    [[unroll]] for (uint step = 1u; step < 32u; step <<= 1u) {
        subgroupBarrier();
        const float other = subgroupShuffleXor(val, step);
        const float vsum  = val + other;
        const float vdiff = other - val;
        val = ((lane & step) != 0u) ? vdiff : vsum;
    }
    val *= PQ_CB_SCALE;   // 1/sqrt(32) — final FWHT normalization (mirrors CUDA's trailing multiply).

    // -----------------------------------------------------------------------
    // 4. Sign flip + norm. Mirrors turboquant.cuh:371-372:
    //      const int sb = (x[ib].sb[tid / 8] >> (tid % 8)) & 1;
    //      val *= (1.0f - 2.0f * sb) * norm;
    //
    //    Convention: sb_bit=0 → +1, sb_bit=1 → −1. (Opposite of the CPU-side
    //    `dequantize_row_ktq2_1` in ggml-quants.c:5986 — we match CUDA.)
    // -----------------------------------------------------------------------
    const uint sb_byte = uint(data_a[ib].sb[lane >> 3]);
    const uint sb_bit  = (sb_byte >> (lane & 7u)) & 1u;
    val *= (1.0 - 2.0 * float(sb_bit)) * norm;

    // -----------------------------------------------------------------------
    // 5. Store. Output layout: row-major, 32 elements per block, contiguous.
    // -----------------------------------------------------------------------
    data_d[ib * 32u + lane] = val;
}
